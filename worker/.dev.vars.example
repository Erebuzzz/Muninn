# Database Connection (Neon Serverless PostgreSQL with pgvector)
DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>/neondb?sslmode=require

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_min_32_chars_here

# AssemblyAI Credentials
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_VOICE_AGENT_ID=
LLM_GATEWAY_URL=https://llm-gateway.assemblyai.com/v1
LLM_GATEWAY_MODEL=claude-3-5-sonnet

# Application Defaults
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
CORS_ORIGINS=https://muninn-nmk.pages.dev,http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost
