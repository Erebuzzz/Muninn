# Database Connection (Neon PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-host>/neondb?ssl=require
SYNC_DATABASE_URL=postgresql://<username>:<password>@<neon-host>/neondb?sslmode=require

# AssemblyAI Credentials
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_VOICE_AGENT_ID=
LLM_GATEWAY_URL=https://llm-gateway.assemblyai.com/v1
LLM_GATEWAY_MODEL=claude-3-5-sonnet

# Application Settings
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
